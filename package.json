{
  "name": "zhuomianling",
  "version": "1.6.1",
  "private": true,
  "license": "MIT",
  "description": "Open-source customizable Live2D desktop pet framework with chat, subtitles, and optional voice features.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run dev:electron && node scripts/start-dev.mjs",
    "dev:timed": "call start-timed.cmd --no-pause",
    "dev:electron": "tsc -p tsconfig.electron.json",
    "prepare:memory-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-memory-runtime.ps1",
    "verify:memory-runtime": "node scripts/verify-memory-runtime.mjs",
    "build": "npm run verify:release-notes && npm run typecheck && vite build && node scripts/clean-electron-output.mjs && tsc -p tsconfig.electron.json && npm run verify:release-assets",
    "start:prod": "cross-env NODE_ENV=production VITE_DEV_SERVER_URL= electron .",
    "preview:prod": "npm run build && npm run start:prod",
    "pack": "npm run build && npm run verify:memory-runtime && electron-builder --dir --publish never && npm run verify:packed-assets",
    "dist:win": "npm run build && npm run verify:memory-runtime && npm run prepare:installer-ui && electron-builder --win --publish never && npm run verify:packed-assets && npm run verify:update-artifacts",
    "prepare:installer-ui": "node scripts/build-update-progress.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "verify:packed-assets": "node scripts/verify-packed-assets.mjs",
    "verify:update-artifacts": "node scripts/verify-update-artifacts.mjs",
    "verify:release-notes": "node scripts/verify-release-notes.mjs",
    "publish:oss": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-oss.ps1",
    "verify:release-assets": "node scripts/verify-release-assets.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "build": {
    "appId": "dev.zhuomianling.desktop",
    "productName": "桌面灵",
    "publish": {
      "provider": "generic",
      "url": "https://zhuomianling.oss-cn-beijing.aliyuncs.com/updates/windows/",
      "useMultipleRangeRequest": false
    },
    "releaseInfo": {
      "releaseNotesFile": "docs/releases/current.md"
    },
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/renderer/live2d/**/*",
      "!dist/**/*.moc",
      "!dist/**/*.moc3",
      "!dist/**/*.model3.json",
      "!dist/**/*.motion3.json",
      "!dist/**/*.exp3.json",
      "!dist/**/*.mtn",
      "!dist/**/*.exp.json",
      "!dist/**/*.pth",
      "!dist/**/*.ckpt",
      "!dist/**/*.wav",
      "!dist/**/*.mp3",
      "!dist/**/*.flac",
      "!dist/**/*.ogg",
      "!dist/**/*.aac",
      "!dist/**/*.local.json",
      "!dist/**/pet.local.json",
      "!node_modules/pend/test.js",
      "!node_modules/buffer-crc32/dist/*.d.cts",
      "!node_modules/buffer-crc32/dist/*.d.mts",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/bin/**",
      "!node_modules/js-yaml/dist/**",
      "assets/icons/**/*",
      "!*.cmd",
      "package.json",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "asarUnpack": [
      "dist/renderer/help.html",
      "dist/renderer/assets/**"
    ],
    "extraResources": [
      {
        "from": ".cache/memory-sidecar-release",
        "to": "memory-sidecar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "win": {
      "icon": "assets/icons/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "scripts/nsis/update-installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "桌面灵",
      "artifactName": "zhuomianling-setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "桌面灵.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ali-oss": "6.23.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "gh-pages": "^6.3.0"
  }
}
